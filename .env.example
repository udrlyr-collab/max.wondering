# CGV target (verified on 2026-07-26)
CGV_COMPANY_CODE=A420
CGV_SITE_NO=0013
CGV_SITE_NAME=용산아이파크몰
CGV_MOVIE_NO=30001323
CGV_MOVIE_NAME=오디세이
CGV_FORMAT_CODE=
CGV_FORMAT_KEYWORD=IMAX
CGV_SCREEN_GRADE_CODE=0301

# Respectful polling. Values below 30 seconds are rejected.
POLL_INTERVAL_SECONDS=60
POLL_JITTER_SECONDS=5
REQUEST_TIMEOUT_SECONDS=20
REQUEST_GAP_SECONDS=0.25
BACKOFF_MAX_SECONDS=900
TELEGRAM_MAX_ATTEMPTS=10
TELEGRAM_RETRY_BASE_SECONDS=60
NOTIFICATION_HEALTH_FAILURE_THRESHOLD=3

# First successful run stores a baseline without notifying by default.
NOTIFY_ON_INITIAL_STATE=false

# Console storage and public URL
CONSOLE_DB_PATH=/data/console.sqlite3
CONSOLE_PUBLIC_ORIGIN=https://max.wondering.kr
CONSOLE_ALLOWED_HOSTS=max.wondering.kr,127.0.0.1,localhost
SEED_DEFAULT_TARGET=true
CONSOLE_WEB_HOST=0.0.0.0
CONSOLE_WEB_PORT=8000
CONSOLE_WORKER_TICK_SECONDS=2

# Required Fernet key for encrypting Telegram credentials entered in the console.
# Keep the real key out of version control. The secrets overlay reads it from
# ./secrets/app_encryption_key instead of this direct environment value.
APP_ENCRYPTION_KEY=
# APP_ENCRYPTION_KEY_FILE=/run/secrets/app_encryption_key

# Legacy CLI runtime paths.
STATE_DB_PATH=./data/moviemax.sqlite3
HEARTBEAT_PATH=./data/heartbeat.json
LOG_LEVEL=INFO
